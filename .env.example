# MariaDB / MySQL verbinding (tevens opslag voor paneelaccounts)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASS=

# Paneel-opslag en registratie
PANEL_DB=minddb_panel
ALLOW_REGISTRATION=true
SESSION_TTL_HOURS=12

# Server
# HOST=127.0.0.1 alleen lokaal; HOST=0.0.0.0 voor toegang van buitenaf
HOST=127.0.0.1
PORT=3005
SESSION_SECRET=verander-dit-geheim
